#!/bin/bash

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: ${0} input.pdf [output.pdf]" >&2
  exit 1
fi

inputFile="${1}"
baseName="$(basename "${inputFile}" .pdf)"
outputFile="${2:-${baseName}.duplex.pdf}"

tempDir="$(mktemp -d)"
trap 'rm -rf "${tempDir}"' EXIT

# Split into single-page PDFs
pdftk "${inputFile}" burst output "${tempDir}/page_%04d.pdf"

# Count pages
pageCount="$(ls "${tempDir}"/page_*.pdf | wc -l)"
halfPageCount="$((pageCount / 2))"

# Merge in duplex order
mergePages=()
for (( i = 0; i < halfPageCount; i++ )); do
  frontPage="${tempDir}/page_$(printf "%04d" $((i + 1))).pdf"
  backPage="${tempDir}/page_$(printf "%04d" $((pageCount - i))).pdf"
  mergePages+=("${frontPage}" "${backPage}")
done

pdftk "${mergePages[@]}" cat output "${outputFile}"

echo "✅ Output written to: ${outputFile}"
