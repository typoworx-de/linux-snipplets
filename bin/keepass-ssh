#!/usr/bin/env python3
# Robust KeePass SSH URL handler for Ubuntu (works with gnome-terminal URL override)
#
# Usage (from KeePass URL override):
#   cmd://gnome-terminal -- keepass-ssh "{URL}"
#   or, like your template:
#   cmd://gnome-terminal -- keepass-ssh 'ssh://{USERNAME}:{T-CONV:/{PASSWORD}/Uri/}@{BASE:RMVSCM}'
#
# Supported URL forms:
#   ssh://user[:password]@host[:port][?identity=/path/to/key&jump=jumphost&strict=accept-new&agent=1&cmd=htop]
#
# Query params (all optional):
#   identity  = path to private key (e.g. ~/.ssh/id_ed25519)
#   jump      = ProxyJump / jumphost (same as proxyjump/ProxyJump)
#   strict    = yes|no|accept-new (default: accept-new)
#   agent     = 1 to enable agent forwarding (-A)
#   knownhosts= custom known_hosts path
#   cmd       = run remote command instead of interactive shell
#
# Environment knobs:
#   KEEPASS_SSH_ERROR_PAUSE   seconds to keep terminal open on error without TTY (default: 8)
#   KEEPASS_SSH_DEBUG         set to 1 to print verbose info before launching
#
import os, sys, shutil, shlex, subprocess, time
from urllib.parse import urlparse, parse_qs

def pause_for_user(non_tty_seconds: int = 30):
    """Keep the window visible so the user can read error text."""
    # If interactive terminal, prompt for Enter
    if sys.stdin.isatty():
        try:
            input("Press Enter to close...")
        except EOFError:
            pass
        return
    # Otherwise, short sleep to keep gnome-terminal visible
    try:
        time.sleep(non_tty_seconds)
    except Exception:
        pass

def die(msg, code=1):
    zenity_bin = shutil.which("zenity")
    if zenity_bin:
        try:
            subprocess.run([zenity_bin, "--error", "--title=KeePass SSH Error", f"--text={msg}"], timeout=5)
        except Exception:
            pass

    sys.stderr.write(f"keepass-ssh: {msg}\n")
    secs = int(os.environ.get("KEEPASS_SSH_ERROR_PAUSE", "30") or "30")
    pause_for_user(secs)
    sys.exit(code)

def first(qs, key, default=None):
    v = qs.get(key)
    return v[0] if v else default

def booly(v, default=False):
    if v is None:
        return default
    return str(v).lower() in {"1","true","yes","on"}

def expand_path(p):
    if not p:
        return p
    return os.path.expanduser(p)

def main():
    if len(sys.argv) != 2:
        die("Usage: keepass-ssh 'ssh://user:pass@host:22?identity=/key'", 2)

    raw = sys.argv[1].strip()
    # Strip surrounding single/double quotes that KeePass might inject
    if (raw.startswith("'") and raw.endswith("'")) or (raw.startswith('"') and raw.endswith('"')):
        raw = raw[1:-1]

    if not raw.startswith("ssh://"):
        die(f"Unsupported URL (must start with ssh://): {raw}")

    u = urlparse(raw)
    host = u.hostname
    if not host:
        die("Missing host in URL")

    user = u.username or ""
    password = u.password or ""
    port = str(u.port) if u.port else None

    qs = parse_qs(u.query, keep_blank_values=True)
    identity = expand_path(first(qs, "identity"))  # path to private key
    jump = first(qs, "jump") or first(qs, "proxyjump") or first(qs, "ProxyJump")
    strict = (first(qs, "strict", "accept-new") or "accept-new").lower()
    if strict not in {"yes","no","accept-new"}:
        strict = "accept-new"
    knownhosts = expand_path(first(qs, "knownhosts"))  # optional custom known_hosts file
    agent = booly(first(qs, "agent"), default=False)
    remote_cmd = first(qs, "cmd")  # optional remote command to run

    ssh_bin = shutil.which("ssh")
    if not ssh_bin:
        die("Cannot find 'ssh' in PATH")

    use_sshpass = bool(password)
    sshpass_bin = shutil.which("sshpass") if use_sshpass else None
    if use_sshpass and not sshpass_bin:
        # Fall back gracefully to plain ssh; user will be prompted for password
        use_sshpass = False

    ssh_args = [ssh_bin]

    # Host key policy
    ssh_args += ["-o", f"StrictHostKeyChecking={strict}"]
    # Avoid long password retry loops
    ssh_args += ["-o", "NumberOfPasswordPrompts=1"]
    # Keep long-lived sessions responsive
    ssh_args += ["-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=3"]

    if knownhosts:
        ssh_args += ["-o", f"UserKnownHostsFile={knownhosts}"]

    if identity:
        ssh_args += ["-i", identity, "-o", "IdentitiesOnly=yes"]

    if agent:
        ssh_args.append("-A")

    if jump:
        ssh_args += ["-J", jump]

    if port:
        ssh_args += ["-p", port]

    userhost = f"{user}@{host}" if user else host

    # Build final argv, taking care not to expose the password
    if use_sshpass:
        argv = [sshpass_bin, "-p", password] + ssh_args + [userhost]
    else:
        argv = ssh_args + [userhost]

    if remote_cmd:
        argv.append(remote_cmd)

    # Helpful, non-sensitive status line (hide password if present)
    pretty = " ".join(shlex.quote(a) for a in argv)
    if password:
        pretty = pretty.replace(password, "****")

    if os.environ.get("KEEPASS_SSH_DEBUG") == "1":
        sys.stderr.write(f"Launching: {pretty}\n")

    # Replace our process with ssh/sshpass so Ctrl+C works naturally
    try:
        os.execvp(argv[0], argv)
    except FileNotFoundError:
        die(f"Failed to exec: {argv[0]} (not found)", 127)
    except PermissionError:
        die(f"Failed to exec: {argv[0]} (permission denied)", 126)
    except Exception as e:
        die(f"Failed to exec: {argv[0]} ({e})", 1)

if __name__ == "__main__":
    main()
