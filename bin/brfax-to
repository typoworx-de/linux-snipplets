#!/bin/bash

set -e

# ── ARGUMENT CHECK ─────────────────────────────────────────────────────
faxRecipient=""
faxflattenedRecipient=""
pdfFile=""

# ── CONFIG ─────────────────────────────────────────────────────────────
enableChunks=false
chunkingConfigured=false
maxPages=25
requiredTools=(pdfinfo pdfseparate pdfunite brpcfax)

showHelp()
{
  cat <<EOF
Usage: $0 [OPTIONS] FAX_NUMBER PDF_DOCUMENT

Send a PDF document using brpcfax.

Options:
  --chunked [N|yes|no]  Enable or disable chunking. If N is provided, use N
                        pages per transmission (default: 25).
  --max-pages N         Enable chunking and use N pages per transmission.
  --no-chunk            Disable chunking and send the PDF in one transmission.
  -h, --help            Show this help message and exit.

If the PDF has more than 25 pages and no chunking option was specified, the
script asks whether it should enable chunking with the default limit.
EOF
}

for argument in "$@"
do
  if [[ "${argument}" == "-h" || "${argument}" == "--help" ]]
  then
    showHelp
    exit 0
  fi
done

# ── TOOL CHECK ─────────────────────────────────────────────────────────
for tool in "${requiredTools[@]}"
do
  if ! command -v "${tool}" >/dev/null 2>&1
  then
    echo "❌ Error: Required tool '${tool}' is not installed."
    echo "   👉 Install with:"
    echo "      sudo apt update && sudo apt install poppler-utils"
    echo "      brpcfax must also be available in PATH"
    exit 1
  fi
done

positionalArgs=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-chunk)
      enableChunks=false
      chunkingConfigured=true
      shift
      ;;
    --max-pages)
      if [[ -z "${2:-}" || ! "$2" =~ ^[1-9][0-9]*$ ]]
      then
        echo "❌ Error: --max-pages requires a positive integer." >&2
        exit 1
      fi
      enableChunks=true
      chunkingConfigured=true
      maxPages="$2"
      shift 2
      ;;
    --max-pages=*)
      maxPages="${1#*=}"
      if [[ ! "${maxPages}" =~ ^[1-9][0-9]*$ ]]
      then
        echo "❌ Error: --max-pages requires a positive integer." >&2
        exit 1
      fi
      enableChunks=true
      chunkingConfigured=true
      shift
      ;;
    --chunked)
      # Look ahead: only treat as number if the next arg is purely numeric
      if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
        enableChunks=true
        chunkingConfigured=true
        maxPages="$2"
        shift 2
        continue
      elif [[ -n "$2" && "$2" =~ ^(yes|true)$ ]]; then
        enableChunks=true
        chunkingConfigured=true
        shift 2
        continue
      elif [[ -n "$2" && "$2" =~ ^(no|false)$ ]]; then
        enableChunks=false
        chunkingConfigured=true
        shift 2
        continue
      fi
      # If not numeric/yes/no, treat --chunked as standalone flag
      enableChunks=true
      chunkingConfigured=true
      shift
      ;;
    --)
      shift
      positionalArgs+=("$@")
      break
      ;;
    -*)
      echo "❌ Error: Unknown option '$1'." >&2
      exit 1
      ;;
    *)
      positionalArgs+=("$1")
      shift
      ;;
  esac
done

# Last two positional arguments
if (( ${#positionalArgs[@]} < 2 )); then
  showHelp >&2
  exit 1
fi

if (( ${#positionalArgs[@]} > 2 )); then
  echo "❌ Error: Too many positional arguments." >&2
  exit 1
fi

faxRecipient="${positionalArgs[-2]}"

# Sanitize faxRecipient: keep only digits
faxflattenedRecipient="${faxRecipient//[!0-9]/}"

pdfFile="${positionalArgs[-1]}"

if [[ ! -f "$pdfFile" ]];
then
  echo "❌ Missing PDF file argument"
  exit 1
fi

# ── PAGE COUNT ────────────────────────────────────────────────────────
pageCount=$(pdfinfo "${pdfFile}" | awk '/^Pages:/ {print $2}')

if [[ -z "${pageCount}" ]]
then
  echo "❌ Unable to determine page count for '${pdfFile}'"
  exit 1
fi

if (( pageCount > 25 )) && ! $chunkingConfigured
then
  while true
  do
    read -r -p "PDF has ${pageCount} pages. Enable chunking with a maximum of ${maxPages} pages per transmission? [y/n] " chunkingAnswer
    case "${chunkingAnswer}" in
      [Yy]|[Yy][Ee][Ss])
        enableChunks=true
        break
        ;;
      [Nn]|[Nn][Oo])
        enableChunks=false
        break
        ;;
      *)
        echo "Please answer y or n."
        ;;
    esac
  done
fi

baseName=$(basename "${pdfFile}" .pdf)
tmpDir="/tmp/brfax/${baseName}"
mkdir -p "${tmpDir}"

# ── PROCESS PDF ────────────────────────────────────────────────────────
if $enableChunks && (( pageCount > maxPages ));
then
  echo "📄 PDF has ${pageCount} pages. Splitting into ${maxPages}-page chunks..."
  for (( i=1; i<=pageCount; i+=maxPages ))
  do
    end=$(( i + maxPages - 1 ))
    if (( end > pageCount ))
    then
      end=${pageCount}
    fi

    chunkFile="${tmpDir}/${baseName}.page${i}-${end}.pdf"

    echo "📄 Creating chunk: pages ${i}-${end}"
    pdfseparate -f "${i}" -l "${end}" "${pdfFile}" "${tmpDir}/${baseName}-%d.pdf"
    pdfunite "${tmpDir}/${baseName}"-*.pdf "${chunkFile}"
    rm -f "${tmpDir}/${baseName}"-*.pdf

    echo "📠 Sending to ${faxflattenedRecipient} (${faxRecipient}), pages ${i}-${end}"
    brpcfax -o fax-number="${faxflattenedRecipient}" "${chunkFile}"

    pagesInChunk=$(( end - i + 1 ))
    sleepSeconds=$(( pagesInChunk * 15 ))
    echo "⏳Waiting ${sleepSeconds}s for device to finish sending..."
    sleep "${sleepSeconds}"

    rm -f "${chunkFile}"
  done

  rmdir --ignore-fail-on-non-empty "${tmpDir}"
else
  echo "📠 Sending in single-transmission to ${faxflattenedRecipient} (${faxRecipient})"
  brpcfax -o fax-number="${faxflattenedRecipient}" "${pdfFile}"
fi
